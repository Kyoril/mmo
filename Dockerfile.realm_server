FROM ubuntu:latest AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y software-properties-common && add-apt-repository ppa:ubuntu-toolchain-r/ppa && apt-get update && apt-get install -y gcc-13 g++-13 cmake git zlib1g-dev libzstd-dev libssl-dev libmariadb-dev-compat uuid-dev

COPY . /app

ENV CC=gcc-13
ENV CXX=g++-13
# The nightly passes the build identity in (the context has no .git); a crash report names it,
# and tools/fetch_server_symbols.ps1 finds the matching unstripped binary by the commit.
ARG MMO_COMMIT=
ARG MMO_VERSION=
RUN mkdir -p docker-build && \
	cd docker-build && \
	cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DMMO_OPENSSL_STATIC=OFF -DMMO_WITH_DEV_COMMANDS=ON -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS=-g -DCMAKE_CXX_FLAGS=-g "-DMMO_BUILD_COMMIT=${MMO_COMMIT}" "-DMMO_BUILD_VERSION=${MMO_VERSION}" /app && \
	make -j4 realm_server && \
	strip --strip-debug -o /app/bin/realm_server.stripped /app/bin/realm_server

# The unstripped binary, for symbolicating crash reports: docker-build.yml exports this stage
# (--target symbols) and the nightly attaches it to its release as server-symbols.zip.
FROM scratch AS symbols
COPY --from=builder /app/bin/realm_server /realm_server


FROM ubuntu:latest

WORKDIR /app

# ca-certificates: the crash report upload verifies TLS against the system trust store.
RUN apt-get update && apt-get install -y ca-certificates libmariadb-dev-compat libssl-dev uuid-dev

RUN mkdir -p /app/config
# Release optimised, debug info stripped; same code layout as the binary in the symbols stage.
COPY --from=builder /app/bin/realm_server.stripped /app/realm_server
COPY --from=builder /app/data/realm/updates /app/updates/realm
COPY --from=builder /app/docker/realm_server/run_server.sh /app/run_server.sh

# Copy binary from builder stage
RUN chmod +x /app/run_server.sh

EXPOSE 8092 8130 6280

# Run login_server when the container launches
CMD ["/app/run_server.sh"]
