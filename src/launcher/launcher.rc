// Launcher resource script.
//
#include "resource.h"
#include "version.h"

#include "Windows.h"

/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMO_VERSION_RES
 PRODUCTVERSION MMO_VERSION_RES
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kyoril"
            VALUE "FileDescription", "MMORPG Launcher"
            VALUE "FileVersion", MMO_VERSION_STR
            VALUE "InternalName", "launcher.exe"
            VALUE "LegalCopyright", "Copyright (C) 2019-2025, Kyoril. All rights reserved."
            VALUE "OriginalFilename", "launcher.exe"
            VALUE "ProductName", "MMORPG Launcher"
            VALUE "ProductVersion", MMO_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Embedded assets. Paths are relative to this .rc file.
//
// This list is the manifest of what ships inside the executable: the launcher draws
// its own UI and loads nothing from disk, so everything it needs is here.
//
// Keep in sync with resource.h, resource_names.h and the launcherAssets list in
// CMakeLists.txt. That last one matters: nothing parses .rc includes, so without it
// editing an asset would not relink and the stale copy would keep shipping.
//

IDR_PNG_SPLASH          RCDATA                  "res/splash.png"
IDR_PNG_PANEL_BOTTOM    RCDATA                  "res/panel_bottom.png"
IDR_PNG_BUTTON_UP       RCDATA                  "res/button_up.png"
IDR_PNG_BUTTON_OVER     RCDATA                  "res/button_over.png"
IDR_PNG_BUTTON_DOWN     RCDATA                  "res/button_down.png"
IDR_PNG_BUTTON_DISABLED RCDATA                  "res/button_disabled.png"
IDR_PNG_PROGRESS_TRACK  RCDATA                  "res/progress_track.png"
IDR_PNG_PROGRESS_FILL   RCDATA                  "res/progress_fill.png"
IDR_PNG_ICON_CLOSE      RCDATA                  "res/icon_close.png"
IDR_PNG_ICON_MINIMIZE   RCDATA                  "res/icon_minimize.png"
IDR_PNG_BORDER_FRAME    RCDATA                  "res/border_frame.png"
IDR_PNG_CONTENT_TEXTURE RCDATA                  "res/content_texture.png"
IDR_PNG_HERO_FRAME      RCDATA                  "res/hero_frame.png"

IDR_TTF_DISPLAY         RCDATA                  "res/font_display.ttf"
IDR_TTF_BODY            RCDATA                  "res/font_body.ttf"

/////////////////////////////////////////////////////////////////////////////
