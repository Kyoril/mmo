    {"match": "Models/Desert/Trees/*", "tags": ["tree"], "scale": [0.8, 1.3], "max_slope": 40, "sink": 0.4, "footprint_scale": 0.12, "may_overlap": ["plant", "bush", "herb", "rock"]},
