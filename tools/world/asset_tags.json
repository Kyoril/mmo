    {"match": "Models/Swamp/SM_stump_*", "tags": ["log"], "scale": [0.7, 1.3], "align_to_slope": true, "max_slope": 30, "sink": 0.6, "footprint_scale": 0.85, "may_overlap": ["plant", "bush", "herb", "rock", "log"]},
