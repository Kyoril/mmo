    {"match": "Models/Desert/Rocks/SM_RockDesert_Cliff*", "tags": ["cliff_rock"], "scale": [0.8, 1.3], "max_slope": 90, "sink": 6.0, "may_overlap": ["rock", "cliff_rock", "rubble", "plant", "bush", "herb"]},
    {"match": "Models/Desert/Rocks/SM_RockDesert_Hoodoo*", "tags": ["cliff_rock"], "scale": [0.8, 1.3], "max_slope": 90, "sink": 6.0, "may_overlap": ["rock", "cliff_rock", "rubble", "plant", "bush", "herb"]},
    {"match": "Models/Desert/Rocks/SM_RockDesert_Layered*", "tags": ["cliff_rock"], "scale": [0.8, 1.3], "max_slope": 90, "sink": 6.0, "may_overlap": ["rock", "cliff_rock", "rubble", "plant", "bush", "herb"]},
    {"match": "Models/Desert/Rocks/SM_RockDesert_Platform*", "tags": ["cliff_rock"], "scale": [0.8, 1.3], "max_slope": 90, "sink": 6.0, "may_overlap": ["rock", "cliff_rock", "rubble", "plant", "bush", "herb"]},
    {"match": "Models/Desert/Rocks/SM_RockDesert_Shelf*", "tags": ["cliff_rock"], "scale": [0.8, 1.3], "max_slope": 90, "sink": 12.0, "may_overlap": ["rock", "cliff_rock", "rubble", "plant", "bush", "herb"]},
    {"match": "Models/Desert/Rocks/SM_RockDesert_CliffHalf*", "sink": 12.0},
    {"match": "Models/Desert/Rocks/SM_RockDesert_HoodooCliff*", "sink": 12.0},
    {"match": "Models/Stones/SM_stone_06*", "scale": [1.0, 2.0], "sink": 3.5},
    {"match": "Models/RuneStone/*", "tags": ["ruin"], "max_slope": 30, "sink": 1.5, "may_overlap": ["rock", "plant", "herb"]},
    {"match": "Models/Trees/*", "max_slope": 45, "sink": 0.5, "footprint_scale": 0.1},
