{
  "version": 1,
  "name": "quarry",
  "description": "A working quarry at a cliff foot: cut-rock piles against the cliff, loose stones, a work tent, a fire, crates, barrels, a cart and tools.",
  "entry": "anchor",
  "clear": [],
  "notes": [],
  "roles": [
